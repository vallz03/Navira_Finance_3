{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'currency', 'startingBalance', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^@ ]+@[^@ ]+$/)" },
          "currency": { ".validate": "newData.val() === 'IDR' || newData.val() === 'USD' || newData.val() === 'SGD'" },
          "startingBalance": { ".validate": "newData.isNumber() && newData.val() >= -1000000000000 && newData.val() <= 1000000000000" },
          "notifications": {
            ".validate": "newData.hasChildren(['weekly', 'budget', 'tips'])",
            "weekly": { ".validate": "newData.isBoolean()" },
            "budget": { ".validate": "newData.isBoolean()" },
            "tips": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())" },
          "$other": { ".validate": false }
        },

        "transactions": {
          ".indexOn": ["dateISO"],
          "$tid": {
            ".validate": "newData.hasChildren(['name', 'category', 'dateISO', 'amount', 'type', 'createdAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "category": { ".validate": "newData.isString() && (newData.val() === 'Pendapatan' || newData.val() === 'Kebutuhan' || newData.val() === 'Makanan' || newData.val() === 'Tagihan' || newData.val() === 'Transportasi' || newData.val() === 'Belanja' || newData.val() === 'Hiburan' || newData.val() === 'Kesehatan' || newData.val() === 'Lainnya')" },
            "dateISO": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "amount": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000000000000" },
            "type": { ".validate": "newData.val() === 'income' || newData.val() === 'expense'" },
            "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? data.val() === newData.val() : newData.val() <= now)" },
            "$other": { ".validate": false }
          }
        },

        "goals": {
          "$gid": {
            ".validate": "newData.hasChildren(['name', 'target', 'saved', 'deadline', 'tone', 'createdAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "target": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < 1000000000000" },
            "saved": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000000000" },
            "deadline": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)" },
            "tone": { ".validate": "newData.val() === 'green' || newData.val() === 'blue' || newData.val() === 'orange'" },
            "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? data.val() === newData.val() : newData.val() <= now)" },
            "$other": { ".validate": false }
          }
        },

        "budgets": {
          "$category": {
            ".validate": "($category === 'Kebutuhan' || $category === 'Makanan' || $category === 'Tagihan' || $category === 'Transportasi' || $category === 'Belanja' || $category === 'Hiburan' || $category === 'Kesehatan' || $category === 'Lainnya') && newData.isNumber() && newData.val() > 0 && newData.val() < 1000000000000"
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
